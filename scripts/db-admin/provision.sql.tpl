-- Idempotente: segunda execucao nao recria roles/databases nem altera senhas existentes.

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = '${OS_DB_USERNAME}') THEN
    EXECUTE format(
      'CREATE ROLE %I LOGIN PASSWORD %L CONNECTION LIMIT %s',
      '${OS_DB_USERNAME}',
      '${OFICINA_DB_PASSWORD}',
      ${OS_CONNECTION_LIMIT}
    );
  ELSE
    EXECUTE format('ALTER ROLE %I CONNECTION LIMIT %s', '${OS_DB_USERNAME}', ${OS_CONNECTION_LIMIT});
  END IF;

  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = '${BILLING_DB_USERNAME}') THEN
    EXECUTE format(
      'CREATE ROLE %I LOGIN PASSWORD %L CONNECTION LIMIT %s',
      '${BILLING_DB_USERNAME}',
      '${BILLING_DB_PASSWORD}',
      ${BILLING_CONNECTION_LIMIT}
    );
  ELSE
    EXECUTE format('ALTER ROLE %I CONNECTION LIMIT %s', '${BILLING_DB_USERNAME}', ${BILLING_CONNECTION_LIMIT});
  END IF;
END
$$;

SELECT format('CREATE DATABASE %I OWNER %I', '${OS_DATABASE_NAME}', '${OS_DB_USERNAME}')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = '${OS_DATABASE_NAME}')\gexec

SELECT format('CREATE DATABASE %I OWNER %I', '${BILLING_DATABASE_NAME}', '${BILLING_DB_USERNAME}')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = '${BILLING_DATABASE_NAME}')\gexec

REVOKE CONNECT ON DATABASE "${OS_DATABASE_NAME}" FROM PUBLIC;
REVOKE CONNECT ON DATABASE "${BILLING_DATABASE_NAME}" FROM PUBLIC;

GRANT CONNECT ON DATABASE "${OS_DATABASE_NAME}" TO "${OS_DB_USERNAME}";
GRANT CONNECT ON DATABASE "${BILLING_DATABASE_NAME}" TO "${BILLING_DB_USERNAME}";

REVOKE ALL ON DATABASE "${OS_DATABASE_NAME}" FROM "${BILLING_DB_USERNAME}";
REVOKE ALL ON DATABASE "${BILLING_DATABASE_NAME}" FROM "${OS_DB_USERNAME}";